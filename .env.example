# Copy to .env (git-ignored). Server-only; none of these may reach a browser bundle.

# Network (Preview for development). Endpoints are read from here, never hard-coded.
MIDNIGHT_NETWORK=preview
MIDNIGHT_PROFILE=schnorr
MIDNIGHT_NODE_RPC_URL=https://rpc.preview.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
PROOF_SERVER_URL=http://localhost:6300

# Contract trust anchors
CIPHERCOMPLY_POLICY_ID=income-usd-85k:v1
CIPHERCOMPLY_DOMAIN=ciphercomply:preview:v1
CIPHERCOMPLY_MIN_ASSURANCE=2
# 32-byte hex address of the deployed contract; subjects are scoped to it
CIPHERCOMPLY_CONTRACT_ADDRESS=

# Server-only key for the document-registry fingerprint (32 random bytes, hex)
REGISTRY_FINGERPRINT_KEY=
DATABASE_PATH=./data/ciphercomply.db

# Oracle signer: a reference to the key in custody, never the key itself
ORACLE_KEY_REF=

# Extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Your Gemini account tier, shown to users in the disclosure. Set to "paid" only if
# the key belongs to a paid (billing-enabled) project; anything else is described
# as the free tier, whose content may be used to improve Google's products.
GEMINI_DATA_USE=
GEMINI_CROSSCHECK_MODEL=gemini-3.5-flash-lite

# --- Development only. `npm run dev:setup` generates these into .env. ---
# Bearer tokens accepted by the dev authenticator: {"<token>": {"principal", "method", "verifiedName"?}}
DEV_SESSION_TOKENS=
# Set to "preview-demo" only on a hosted demo against the Preview network. It lets the
# two development-only pieces below run with NODE_ENV=production. Leave empty otherwise.
CIPHERCOMPLY_DEMO_MODE=
# Second policy, "aged 18 or over", decided from an issuer-signed record. Set by
# `npm run deploy -- --age`. Leave empty to offer only the default policy.
CIPHERCOMPLY_AGE_CONTRACT_ADDRESS=
# Extra document issuers to trust, as JSON [{"name","fingerprint256"}], on top of
# trust/document-signers.json. For a test issuer only.
EXTRA_DOCUMENT_SIGNERS=
# Block explorer base URL (no trailing slash). Links use /transactions/0x<hash>, /blocks/<height>, /contracts/<address>.
MIDNIGHT_EXPLORER_URL=
# Pages-only deployments: origin of the deployment that serves /api (no trailing slash)
BACKEND_ORIGIN=
# Oracle signing scalar held in process memory (refused when NODE_ENV=production, except in demo mode)
ORACLE_DEV_SECRET_SCALAR=
ADMIN_DEV_SECRET_HEX=
# JSON array of issuers the policy accepts
POLICY_ISSUER_ALLOW_LIST=
# Server wallet seed (secret). `npm run wallet` generates it.
MIDNIGHT_WALLET_SEED=
