{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "lib",
    "test",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "contracts/managed"
  ]
}
